platform :ios, '15.0'

workspace 'KomicaViewer.xcworkspace'
project 'KomicaViewer.xcodeproj'

target 'KomicaViewer' do
  use_frameworks!

  pod 'MBProgressHUD', '~> 1.2'
  pod 'PureLayout', '~> 3.1'
  pod 'CCBottomRefreshControl', :git => 'https://github.com/CraigZheng/CCBottomRefreshControl.git'
  pod 'Firebase/Analytics'
  pod 'Google-Mobile-Ads-SDK'
  pod 'SwiftMessages', '~> 9.0'
  pod 'TTTAttributedLabel', '~> 2.0'
  pod 'SDWebImage', '~> 5.0'

  target 'KomicaViewerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['GCC_WARN_ABOUT_RETURN_TYPE'] = 'YES'
      # Keep pods in Swift 5 language mode for Xcode 26.
      config.build_settings['SWIFT_VERSION'] = '5.0'
      config.build_settings['DEAD_CODE_STRIPPING'] = 'YES'
    end
  end

  # KomicaEngine lives beside this repo and vendors DTCoreText as a submodule.
  prepare = File.expand_path('../../komicaengine/Scripts/prepare-dtcoretext.sh', __dir__)
  if File.exist?(prepare)
    system('bash', prepare) or raise('Failed to prepare DTCoreText for Xcode 26')
  else
    Pod::UI.warn("Skipping DTCoreText prepare script (not found at #{prepare})")
  end
end
